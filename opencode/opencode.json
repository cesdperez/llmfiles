{
  "$schema": "https://opencode.ai/config.json",
  "model": "claude-agent/opus",
  "instructions": [
    "~/llmfiles/shared/CLAUDE.md",
    "~/llmfiles/opencode/compatibility.md"
  ],
  "commands": {
    "fullconduct": {
      "description": "/fullsend run by the conductor: builders make the changes, reviewer agents review, and the run ends at a local branch, MR or merge.",
      "agent": "conductor",
      "template": "Read `~/llmfiles/opencode/fullconduct.md`, then `~/llmfiles/commands/fullsend.md`, and run it with these arguments:\n\n$ARGUMENTS"
    }
  },
  "permissions": [
    { "action": "subagent", "resource": "builder-*", "effect": "deny" },
    { "action": "subagent", "resource": "ab-judge", "effect": "deny" },
    { "action": "skill", "resource": "bugbounty", "effect": "deny" },
    { "action": "skill", "resource": "dailyworkrecap", "effect": "deny" },
    { "action": "skill", "resource": "fleet", "effect": "deny" },
    { "action": "skill", "resource": "fullsend", "effect": "deny" },
    { "action": "skill", "resource": "glablensedreview", "effect": "deny" },
    { "action": "skill", "resource": "glabsummary", "effect": "deny" },
    { "action": "skill", "resource": "locallensedreview", "effect": "deny" },
    { "action": "skill", "resource": "skillbuilder", "effect": "deny" },
    { "action": "skill", "resource": "waitwhat", "effect": "deny" },
    { "action": "skill", "resource": "whichagents", "effect": "deny" },
    { "action": "skill", "resource": "whichmodels", "effect": "deny" }
  ]
}
